# =============================================================================
# DRAKO EDITS - Assets (imagenes, audio, videos de templates)
# Las CARPETAS si se trackean (via .gitkeep), los archivos pesados NO
# =============================================================================

# Imagenes en assets
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.png
assets/**/*.webp
assets/**/*.bmp
assets/**/*.gif

# Audio en assets
assets/**/*.mp3
assets/**/*.wav
assets/**/*.m4a
assets/**/*.ogg

# Videos generados (output de los generators)
output/**/*.mp4
output/**/*.avi
output/**/*.mov
output/**/*.mkv

# =============================================================================
# DRAKO EDITS - tools_output (descargas y ediciones)
# Todo lo descargado/procesado es pesado y no va al repo
# =============================================================================

# Videos descargados y editados
tools_output/**/*.mp4
tools_output/**/*.mov
tools_output/**/*.avi
tools_output/**/*.mkv
tools_output/**/*.webm

# Audios descargados
tools_output/**/*.mp3
tools_output/**/*.wav
tools_output/**/*.m4a
tools_output/**/*.ogg

# Posts de Instagram (fotos descargadas)
tools_output/**/*.jpg
tools_output/**/*.jpeg
tools_output/**/*.png
tools_output/**/*.webp

# Metadata de instaloader
tools_output/**/*.json
tools_output/**/*.xz

