{
  "perfiles_target": [
    "elmello2023"
  ],
  "scraping": {
    "brave_path": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
    "scroll_count_inicial": 20,
    "scroll_count_nuevos": 3,
    "scroll_delay": 3.0,
    "delay_entre_perfiles": 5,
    "skip_if_no_new_for_n_runs": 3
  },
  "descarga": {
    "min_likes": 5000,
    "max_por_sesion": 99999,
    "delay_entre_posts": 2
  },
  "clasificacion": {
    "modelo": "gpt-4o",
    "max_tokens": 1800,
    "max_por_sesion": 20,
    "paralelismo": 3,
    "delay_entre_calls": 2,
    "categorias": [
      "humor_absurdo",
      "humor_dark",
      "cringe",
      "sad_funny",
      "wholesome",
      "plot_twist",
      "relatable",
      "rage",
      "sus",
      "intellectual"
    ]
  },
  "match": {
    "modelo": "gpt-4o-mini",
    "auto_accept_threshold": 90,
    "auto_skip_threshold": 40,
    "max_por_sesion": 10,
    "max_tokens": 600
  },
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "meme_max_ratio": 0.7,
    "clip_max_ratio": 0.4,
    "clip_min_ratio": 0.3,
    "meme_border_ratio": 0.03,
    "black_bar_threshold": 15,
    "black_bar_min_rows": 8,
    "max_crop_ratio": 0.3,
    "caption_sizes": {
      "S": 45,
      "M": 65,
      "L": 85,
      "XL": 110
    },
    "stroke_width": 4
  },
  "upload": {
    "platforms": [
      "youtube",
      "tiktok",
      "instagram"
    ],
    "modelo_metadata": "gpt-4o-mini",
    "max_tokens_metadata": 400
  },
  "telegram": {
    "enabled": true,
    "bot_token": "ENV:TELEGRAM_BOT_TOKEN",
    "chat_id": "ENV:TELEGRAM_CHAT_ID",
    "notificar_video_generado": true,
    "notificar_upload": true,
    "notificar_errores": true,
    "resumen_diario": false
  },
  "rate_limits": {
    "openai": {
      "max_requests_per_day": 500,
      "max_tokens_per_day": 100000,
      "warning_threshold": 0.8
    },
    "instagram": {
      "max_requests_per_day": 200,
      "warning_threshold": 0.7,
      "requests_dia": 99999
    }
  },
  "logging": {
    "level": "INFO",
    "file_rotation_mb": 5,
    "keep_logs_days": 30
  },
  "retry": {
    "max_attempts": 3,
    "backoff_factor": 2,
    "retry_on_bad_json": true,
    "lower_temp_on_retry": true
  },
  "dry_run": false
}